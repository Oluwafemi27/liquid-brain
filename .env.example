# Copy to .env and fill in. Restart `npm run dev` after changing this file.

# --- Backend (Supabase) ---
# Schema is already applied to the "liquid-brain" project (jnmsmtynkaocgntdluhh).
# Get SUPABASE_URL + the SERVICE ROLE key (not anon) from
# Project Settings > API in the Supabase dashboard.
# Without these, the app still runs — chat/keys/skills/connector history just won't persist.
SUPABASE_URL=https://jnmsmtynkaocgntdluhh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Brain Chat fallback model ---
# Optional now that BYOK model keys exist (Settings > AI Model Keys) — this
# is only used if no default key is connected there. Either is fine to skip.
ANTHROPIC_API_KEY=

# --- Code sandbox (E2B) ---
# Lets the agent actually execute code for plan steps that need it (real
# calculations, data transforms, testing a script) instead of guessing the
# result. Get a key at https://e2b.dev — without it, those steps fail with
# a clear "sandbox not configured" message instead of silently faking output.
E2B_API_KEY=

# --- App URL ---
# Used to build OAuth redirect_uri values. Set this to your real deployed
# origin in production (e.g. https://app.aduf.ai); safe to leave blank in
# local dev, where it falls back to the request's own origin.
APP_URL=

# --- OAuth connector apps ---
# Register an app with each provider and paste its client id/secret here.
# The "Connect" button in Settings automatically switches from the local
# demo animation to a real redirect once a provider's pair is set.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Used for both Google Analytics and Google Sheets (same Google Cloud OAuth app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Ads.
META_CLIENT_ID=
META_CLIENT_SECRET=

# Paystack has no OAuth — it connects with a secret API key the owner pastes
# in directly. That key-entry flow isn't built yet; see src/lib/server/oauth-providers.ts.

# Telegram has no OAuth either — the owner pastes a bot token (from @BotFather)
# into Settings > Connections > Telegram. Nothing to set here, but APP_URL must
# be your public https origin: Telegram delivers messages to
# {APP_URL}/api/connectors/telegram/webhook. Run supabase/migrations/014 first.

# --- More OAuth connectors -------------------------------------------------------
# Redirect URI for every provider below:  {APP_URL}/api/connectors/<id>/callback
# (ids: drive, gmail, instagram, tiktok, discord, aliexpress, alibaba). See docs/CONNECTORS.md.

# Google Drive + Gmail reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above — just add the
# two redirect URIs (…/drive/callback, …/gmail/callback) and enable the Drive + Gmail APIs.

# Instagram API with Instagram Login (its own app id/secret — NOT the Meta Ads pair).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok for Developers: TikTok calls the app id a "client key".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Discord Developer Portal → OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# AliExpress Open Platform and Alibaba.com Open Platform (app key + secret).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Semrush, Jumia and Paystack have no OAuth redirect: the owner pastes credentials in
# Settings → Integrations and they're stored encrypted in Supabase Vault (migration 016).

# --- Trust layer (migrations 017–019) ---
# 32 random bytes, base64 — encrypts OAuth logins at rest. Generate: openssl rand -base64 32
# Keep it only here (never in the database). Existing plaintext logins upgrade automatically on next use.
TOKEN_ENCRYPTION_KEY=
# Any long random string. Vercel Cron sends it as a Bearer token to /api/cron/daily.
CRON_SECRET=
# Optional: lets ADUF email the daily summary / alerts to the owner's sign-in address (resend.com).
RESEND_API_KEY=
DIGEST_FROM=ADUF AI <onboarding@resend.dev>
# Public URL of the app, used for the "Open ADUF" link in summaries.
APP_URL=

# --- Plans, tokens & payments (migration 020) ---
# ADUF's OWN Paystack account — what customers pay you for plans and token top-ups.
# Then set this webhook URL in Paystack (Settings → API Keys & Webhooks): https://YOUR-APP/api/billing/paystack-webhook
PAYSTACK_SECRET_KEY=

# --- Skills (src/skills) ---
# Competitor Spy: Firecrawl (firecrawl.dev) for single pages, Apify for approved scraper actors.
FIRECRAWL_API_KEY=
APIFY_TOKEN=
# Comma-separated `username~actor-name` the agent may run (each run costs Apify credit).
# Default: apify~website-content-crawler,apify~facebook-ads-scraper
APIFY_ALLOWED_ACTORS=
# Business Analyst knowledge graph (cognee Cloud): your tenant host, API key, tenant id.
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TENANT_ID=
# Dropship skill store tools (Medusa v2 Admin): your backend URL and a SECRET API key (Settings -> Secret API Keys).
MEDUSA_BACKEND_URL=
MEDUSA_ADMIN_TOKEN=
# Supplier orders: CJ Dropshipping access token (created from your CJ API key; it expires, so refresh it). Orders are created UNPAID.
CJ_ACCESS_TOKEN=
# Ads Operator: optional system-user token (read access). Otherwise the Meta connection from Settings is used.
META_ADS_ACCESS_TOKEN=
META_GRAPH_VERSION=
# Sub-agents: wall-clock limit per helper in milliseconds (default 55000).
ADUF_SUBAGENT_TIMEOUT_MS=

# Composio (connectors). Free plan, no card: https://composio.dev  Create a key in the dashboard.
# Composio hosts the sign-in flows and stores each owner's app logins; nothing to self-host.
COMPOSIO_API_KEY=

# ---- Monitoring (all optional; nothing is sent until the key is set) ----
# Sentry (errors). Browser DSN is public by design. Same DSN can be used for both.
VITE_SENTRY_DSN=
SENTRY_DSN=
# Datadog: browser performance (RUM) needs the first three, server logs need DD_API_KEY.
VITE_DD_APPLICATION_ID=
VITE_DD_CLIENT_TOKEN=
VITE_DD_SITE=datadoghq.com
# Admin > Monitoring page (read-only; none of these are ever sent to the browser):
#  - Sentry: an Auth Token with only "project:read" and "event:read", plus your org and project slugs
#  - Datadog: an Application key (Organization Settings > Application Keys); DD_SERVICE only if you renamed it
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_API_BASE=https://de.sentry.io   (only for the EU region or a self-hosted Sentry)
DD_APP_KEY=
# DD_SERVICE=aduf-api
DD_API_KEY=
DD_SITE=datadoghq.com
APP_ENV=production
VITE_APP_ENV=production

# ---- Azure OpenAI (optional extra AI provider) ----
# Resource address and the *deployment name* you created in Azure AI Foundry. The API key is added in Settings.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# --- Security ---------------------------------------------------------------------------------
# Signs the ten-minute links used to open documents. Any long random string (e.g. `openssl rand -hex 32`).
# If unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY.
DOCUMENT_LINK_SECRET=
# Extra websites the browser may call, space separated (only if you add a new browser-side service).
CSP_CONNECT_EXTRA=
# Set to report-only to log Content-Security-Policy problems without blocking anything.
CSP_MODE=

# --- File scanning and retention ----------------------------------------------------------------
# ClamAV daemon (host name and port). Strongly recommended. Unreachable scanner = uploads refused.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Allow uploads when ClamAV is down (not recommended).
SCAN_FAIL_OPEN=
# VirusTotal API key: looks up each file's fingerprint (the file itself is never sent).
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_MIN_DETECTIONS=2
# Hours an uploaded original is kept (max 24, default 23).
ATTACHMENT_TTL_HOURS=23
# Files this big (bytes) are deleted right after being read. Default 8388608 (8 MB).
LARGE_FILE_BYTES=8388608
# Also delete the extracted text after this many hours (empty = keep it with the conversation).
ATTACHMENT_TEXT_RETENTION_HOURS=
# Set to "off" to disable the 15-minute purge timer inside the server.
PURGE_TIMER=

# --- Redis (optional shared cache and rate limits) ------------------------------------------------
REDIS_URL=
