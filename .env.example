# Copy to .env and fill in. Restart `npm run dev` after changing this file.

# --- Backend (Supabase) ---
# Schema is already applied to the "liquid-brain" project (jnmsmtynkaocgntdluhh).
# Get SUPABASE_URL + the SERVICE ROLE key (not anon) from
# Project Settings > API in the Supabase dashboard.
# Without these, the app still runs — chat/keys/skills/connector history just won't persist.
SUPABASE_URL=https://jnmsmtynkaocgntdluhh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Brain Chat fallback model ---
# Optional now that BYOK model keys exist (Settings > AI Model Keys) — this
# is only used if no default key is connected there. Either is fine to skip.
ANTHROPIC_API_KEY=

# --- Code sandbox (E2B) ---
# Lets the agent actually execute code for plan steps that need it (real
# calculations, data transforms, testing a script) instead of guessing the
# result. Get a key at https://e2b.dev — without it, those steps fail with
# a clear "sandbox not configured" message instead of silently faking output.
E2B_API_KEY=

# --- App URL ---
# Used to build OAuth redirect_uri values. Set this to your real deployed
# origin in production (e.g. https://app.aduf.ai); safe to leave blank in
# local dev, where it falls back to the request's own origin.
APP_URL=

# --- OAuth connector apps ---
# Register an app with each provider and paste its client id/secret here.
# The "Connect" button in Settings automatically switches from the local
# demo animation to a real redirect once a provider's pair is set.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Used for both Google Analytics and Google Sheets (same Google Cloud OAuth app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Ads.
META_CLIENT_ID=
META_CLIENT_SECRET=

# Paystack has no OAuth — it connects with a secret API key the owner pastes
# in directly. That key-entry flow isn't built yet; see src/lib/server/oauth-providers.ts.

# Telegram has no OAuth either — the owner pastes a bot token (from @BotFather)
# into Settings > Connections > Telegram. Nothing to set here, but APP_URL must
# be your public https origin: Telegram delivers messages to
# {APP_URL}/api/connectors/telegram/webhook. Run supabase/migrations/014 first.

# --- More OAuth connectors -------------------------------------------------------
# Redirect URI for every provider below:  {APP_URL}/api/connectors/<id>/callback
# (ids: drive, gmail, instagram, tiktok, discord, aliexpress, alibaba). See docs/CONNECTORS.md.

# Google Drive + Gmail reuse GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above — just add the
# two redirect URIs (…/drive/callback, …/gmail/callback) and enable the Drive + Gmail APIs.

# Instagram API with Instagram Login (its own app id/secret — NOT the Meta Ads pair).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# TikTok for Developers: TikTok calls the app id a "client key".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Discord Developer Portal → OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# AliExpress Open Platform and Alibaba.com Open Platform (app key + secret).
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Semrush, Jumia and Paystack have no OAuth redirect: the owner pastes credentials in
# Settings → Integrations and they're stored encrypted in Supabase Vault (migration 016).
