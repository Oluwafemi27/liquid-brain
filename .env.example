# Copy to .env and fill in. Restart `npm run dev` after changing this file.

# --- Backend (Supabase) ---
# Schema is already applied to the "liquid-brain" project (jnmsmtynkaocgntdluhh).
# Get SUPABASE_URL + the SERVICE ROLE key (not anon) from
# Project Settings > API in the Supabase dashboard.
# Without these, the app still runs — chat/keys/skills/connector history just won't persist.
SUPABASE_URL=https://jnmsmtynkaocgntdluhh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Brain Chat fallback model ---
# Optional now that BYOK model keys exist (Settings > AI Model Keys) — this
# is only used if no default key is connected there. Either is fine to skip.
ANTHROPIC_API_KEY=

# --- App URL ---
# Used to build OAuth redirect_uri values. Set this to your real deployed
# origin in production (e.g. https://app.aduf.ai); safe to leave blank in
# local dev, where it falls back to the request's own origin.
APP_URL=

# --- OAuth connector apps ---
# Register an app with each provider and paste its client id/secret here.
# The "Connect" button in Settings automatically switches from the local
# demo animation to a real redirect once a provider's pair is set.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Used for both Google Analytics and Google Sheets (same Google Cloud OAuth app).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Used for both Meta Ads and WhatsApp Business (same Meta app).
META_CLIENT_ID=
META_CLIENT_SECRET=

# Paystack has no OAuth — it connects with a secret API key the owner pastes
# in directly. That key-entry flow isn't built yet; see src/lib/server/oauth-providers.ts.
